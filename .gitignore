# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# --- CloverDX Data Manager customization workspace boundaries ---
# Scratch — recon dumps, extracted JARs, anything disposable.
.work/

# Build artifacts — regenerated by the deploy script.
output/
deploy/branding/

# NOTE: customization/ (the customization source of truth) is deliberately
# NOT ignored. Track everything under customization/ in VCS.

# OS / editor cruft
*.swp

# Local agent/editor settings
settings.json